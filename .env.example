# Base de datos PostgreSQL (Neon)
DATABASE_URL=postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/nombre-bd?sslmode=require

# JWT
JWT_SECRET=tu_clave_secreta

# Servidor
PORT=3000
FRONTEND_URL=http://localhost:3000

# Tiempo límite para ingreso después de solicitar (minutos)
TIEMPO_LIMITE_INGRESO_MIN=30

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_LOGIN_MAX=10

# Logging (debug, info, warn, error)
LOG_LEVEL=info
